{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web: Vite",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/client",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "API: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["server.api:app", "--reload"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe"
    }
  ],
  "compounds": [
    {
      "name": "Web and API",
      "configurations": ["Web: Vite", "API: FastAPI"],
      "stopAll": true
    }
  ]
}
