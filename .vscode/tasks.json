{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Web: start local server",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": ".*", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v.*",
          "endsPattern": "Local:.*http://"
        }
      }
    },
    {
      "label": "API: start FastAPI server",
      "type": "shell",
      "command": "python -m uvicorn api:app --reload",
      "isBackground": true,
      "problemMatcher": {
        "owner": "uvicorn",
        "pattern": { "regexp": ".*", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started reloader process",
          "endsPattern": "Uvicorn running on"
        }
      }
    }
  ]
}
